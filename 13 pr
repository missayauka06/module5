#   Классы товаров, заказов и обработки

class Product:
    def __init__(self, name, price):
        self.name = name
        self.price = price


class Order:
    def __init__(self, customer):
        self.customer = customer
        self.cart = []
        self.paid = False

    def add_product(self, product):
        self.cart.append(product)
        print(f"Добавлен товар: {product.name} ({product.price}₸)")

    def total(self):
        return sum(p.price for p in self.cart)

    def pay(self, money):
        print("\n--- Оплата ---")
        if money >= self.total():
            self.paid = True
            print("Оплата прошла успешно.")
        else:
            print("Ошибка оплаты: недостаточно средств.")
            self.paid = False

    def summary(self):
        print("\n--- Корзина ---")
        for p in self.cart:
            print(f"- {p.name} ({p.price}₸)")
        print(f"Итого: {self.total()}₸")


class OrderProcessor:
    def process(self, order):
        if not order.paid:
            print("\nНельзя обработать неоплаченный заказ.")
            return

        print("\n--- Обработка заказа ---")
        print("Заказ отправлен на склад...")
        print("Заказ упакован...")
        print("Заказ передан в службу доставки...")
        print("Заказ успешно отправлен!")



if __name__ == "__main__":
    order = Order("Алия")

    order.add_product(Product("Ноутбук", 350000))
    order.add_product(Product("Мышь", 7000))

    order.summary()

    order.pay(360000)

    processor = OrderProcessor()
    processor.process(order)
