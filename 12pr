import random
import time

#  Логин пользователя

def login(user):
    print(f"\nПользователь {user} входит в систему...")
    time.sleep(0.5)
    print("Вход успешно выполнен.")
    return True


#  Добавление товаров в корзину

def add_items_to_cart(cart, items):
    print("\nПользователь добавляет товары в корзину...")
    time.sleep(0.5)
    for item in items:
        cart.append(item)
        print(f" → Товар добавлен: {item}")
    print("Корзина обновлена.")
    return cart


#  Проверка доступности товаров на складе

def check_availability(cart, warehouse):
    print("\nПроверка наличия товаров на складе...")
    time.sleep(1)

    unavailable = []

    for item in cart:
        if warehouse.get(item, 0) <= 0:
            unavailable.append(item)

    if unavailable:
        print("Недоступные товары:", unavailable)
        return {"status": "fail", "unavailable": unavailable}
    else:
        print("Все товары доступны.")
        return {"status": "ok"}


#  Онлайн-платёж через платёжный шлюз

def online_payment(amount):
    print("\nОбработка онлайн-платежа через платёжный шлюз...")
    time.sleep(1)

    success = random.choice([True, False, True])  # вероятность успеха ~66%

    if success:
        print("Платёж успешно выполнен.")
        return True
    else:
        print("Платёж отклонён платёжным шлюзом.")
        return False


#  Уведомление склада о сборке заказа

def notify_warehouse(cart):
    print("\nУведомление склада о сборке заказа...")
    time.sleep(1)
    print("Склад получил заявку на сборку заказа.")
    return True


#  Основной процесс

def process_order(user, items, warehouse, payment_method):
    print("\n======== ОФОРМЛЕНИЕ ЗАКАЗА ========\n")

    login(user)

    cart = []
    add_items_to_cart(cart, items)

    print("\nПользователь подтверждает заказ.")

    availability = check_availability(cart, warehouse)
    if availability["status"] == "fail":
        print("Пожалуйста, измените корзину.")
        return

    print("\nЗаказ подтверждён.")

    print(f"\nВыбран способ оплаты: {payment_method}")

    if payment_method == "online":
        if not online_payment(amount=100):
            print("Пожалуйста, повторите оплату.")
            return
    else:
        print("Оплата будет выполнена при доставке.")

    print("\nСистема: заказ успешно оформлен!")

    notify_warehouse(cart)

    print("\nПроцесс завершён. Спасибо за покупку!")



warehouse = {
    "Ноутбук": 3,
    "Мышь": 0,
    "Клавиатура": 5
}

items = ["Ноутбук", "Клавиатура"]

process_order(
    user="Ayan",
    items=items,
    warehouse=warehouse,
    payment_method="online"   # или "delivery"
)
