from abc import ABC, abstractmethod


#   Интерфейс состояния

class TicketState(ABC):

    @abstractmethod
    def send_to_client(self):
        pass

    @abstractmethod
    def pay(self):
        pass

    @abstractmethod
    def confirm(self):
        pass

    @abstractmethod
    def cancel(self):
        pass


#   Контекст — заявка

class TicketRequest:

    def __init__(self):
        self.created = CreatedState(self)
        self.waiting = WaitingForPaymentState(self)
        self.paid = PaidState(self)
        self.confirmed = ConfirmedState(self)
        self.cancelled = CancelledState(self)

        self.state = self.created

    def set_state(self, new_state):
        self.state = new_state

    def send_to_client(self):
        self.state.send_to_client()

    def pay(self):
        self.state.pay()

    def confirm(self):
        self.state.confirm()

    def cancel(self):
        self.state.cancel()


#   Состояние: Created

class CreatedState(TicketState):

    def __init__(self, req):
        self.req = req

    def send_to_client(self):
        print("Заявка отправлена клиенту. Ожидаем оплату.")
        self.req.set_state(self.req.waiting)

    def pay(self):
        print("Нельзя оплатить — заявка не отправлена клиенту.")

    def confirm(self):
        print("Нельзя подтвердить — заявка не оплачена.")

    def cancel(self):
        print("Заявка отменена.")
        self.req.set_state(self.req.cancelled)


#   Состояние: WaitingForPayment

class WaitingForPaymentState(TicketState):

    def __init__(self, req):
        self.req = req

    def send_to_client(self):
        print("Заявка уже отправлена.")

    def pay(self):
        print("Оплата получена.")
        self.req.set_state(self.req.paid)

    def confirm(self):
        print("Нельзя подтвердить — заявка не оплачена.")

    def cancel(self):
        print("Время оплаты истекло. Заявка отменена.")
        self.req.set_state(self.req.cancelled)


#   Состояние: Paid

class PaidState(TicketState):

    def __init__(self, req):
        self.req = req

    def send_to_client(self):
        print("Заявка уже оплачена, отправлять повторно нельзя.")

    def pay(self):
        print("Заявка уже оплачена.")

    def confirm(self):
        print("Бронирование подтверждено.")
        self.req.set_state(self.req.confirmed)

    def cancel(self):
        print("Заявка не может быть отменена после оплаты.")
        self.req.set_state(self.req.cancelled)


#   Состояние: Confirmed

class ConfirmedState(TicketState):

    def __init__(self, req):
        self.req = req

    def send_to_client(self):
        print("Заявка уже подтверждена.")

    def pay(self):
        print("Уже оплачено.")

    def confirm(self):
        print("Уже подтверждено.")

    def cancel(self):
        print("Подтверждённую заявку нельзя отменить.")


#   Состояние: Cancelled

class CancelledState(TicketState):

    def __init__(self, req):
        self.req = req

    def send_to_client(self):
        print("Заявка отменена. Действие невозможно.")

    def pay(self):
        print("Оплата невозможна — заявка отменена.")

    def confirm(self):
        print("Нельзя подтвердить отменённую заявку.")

    def cancel(self):
        print("Заявка уже отменена.")


#   Пример использования

if __name__ == "__main__":
    request = TicketRequest()

    print("\n--- Процесс №1 ---")
    request.send_to_client()
    request.pay()
    request.confirm()

    print("\n--- Процесс №2 (отмена) ---")
    request = TicketRequest()
    request.send_to_client()
    request.cancel()
