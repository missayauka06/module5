#   Модели данных

class Book:
    def __init__(self, title, author, genre, available=True):
        self.title = title
        self.author = author
        self.genre = genre
        self.available = available


class User:
    def __init__(self, name, role="reader"):
        self.name = name
        self.role = role
        self.reservations = []

    def __str__(self):
        return f"{self.name} ({self.role})"


class Branch:
    def __init__(self, name):
        self.name = name
        self.catalog = []


#   Система управления библиотекой

class LibrarySystem:
    def __init__(self):
        self.branches = {}
        self.users = {}

    def register_user(self, name, role="reader"):
        user = User(name, role)
        self.users[name] = user
        print(f"Пользователь зарегистрирован: {user}")
        return user

    def add_branch(self, branch_name):
        if branch_name in self.branches:
            print("Филиал уже существует.")
            return
        self.branches[branch_name] = Branch(branch_name)
        print(f"Филиал добавлен: {branch_name}")

    def remove_branch(self, branch_name):
        if branch_name in self.branches:
            del self.branches[branch_name]
            print(f"Филиал удалён: {branch_name}")
        else:
            print("Филиал не найден.")

    def add_book(self, branch_name, book):
        branch = self.branches.get(branch_name)
        if branch:
            branch.catalog.append(book)
            print(f"Книга '{book.title}' добавлена в каталог филиала '{branch_name}'.")
        else:
            print("Филиал не найден.")

    def remove_book(self, branch_name, title):
        branch = self.branches.get(branch_name)
        if branch:
            branch.catalog = [b for b in branch.catalog if b.title != title]
            print(f"Книга '{title}' удалена из каталога '{branch_name}'.")
        else:
            print("Филиал не найден.")

    def search_books(self, branch_name, query):
        branch = self.branches.get(branch_name)
        if not branch:
            print("Филиал не найден.")
            return []

        print(f"\nПоиск книг по запросу: '{query}'")
        results = [b for b in branch.catalog if
                   query.lower() in b.title.lower() or
                   query.lower() in b.author.lower() or
                   query.lower() in b.genre.lower()]
        return results

    def reserve_book(self, user_name, branch_name, title):
        user = self.users.get(user_name)
        branch = self.branches.get(branch_name)

        if not user or not branch:
            print("Ошибка: пользователь или филиал не найдены.")
            return

        for book in branch.catalog:
            if book.title == title:
                if book.available:
                    book.available = False
                    user.reservations.append(book.title)
                    print(f"Книга '{title}' успешно забронирована пользователем {user_name}.")
                else:
                    print(f"Книга '{title}' недоступна для бронирования.")
                return

        print("Книга не найдена.")

    def cancel_reservation(self, user_name, branch_name, title):
        user = self.users.get(user_name)
        branch = self.branches.get(branch_name)

        if not user or not branch:
            print("Ошибка: пользователь или филиал не найдены.")
            return

        if title in user.reservations:
            user.reservations.remove(title)

            for book in branch.catalog:
                if book.title == title:
                    book.available = True

            print(f"Бронирование книги '{title}' отменено.")
        else:
            print("У пользователя нет такой брони.")

    def analytics(self, branch_name):
        branch = self.branches.get(branch_name)
        if not branch:
            print("Филиал не найден.")
            return

        total_books = len(branch.catalog)
        unavailable = sum(not b.available for b in branch.catalog)

        print("\n--- АНАЛИТИКА ---")
        print(f"Филиал: {branch_name}")
        print(f"Всего книг: {total_books}")
        print(f"Выдано/забронировано: {unavailable}")
        print(f"Доступно: {total_books - unavailable}")



system = LibrarySystem()

system.add_branch("Центральный")
system.add_branch("Северный")

system.register_user("Айжан", "reader")
system.register_user("Марат", "librarian")
system.register_user("Админ", "admin")

system.add_book("Центральный", Book("Война и мир", "Толстой", "Роман"))
system.add_book("Центральный", Book("Гарри Поттер", "Роулинг", "Фэнтези"))

results = system.search_books("Центральный", "Гарри")
for r in results:
    print(f"Найдена книга: {r.title}")

system.reserve_book("Айжан", "Центральный", "Гарри Поттер")

system.cancel_reservation("Айжан", "Центральный", "Гарри Поттер")

system.analytics("Центральный")













