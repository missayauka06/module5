from dataclasses import dataclass
from typing import List



@dataclass
class Client:
    name: str

    def request_venue(self, system: "BookingSystem", date: str):
        print(f"[Клиент] {self.name}: хочу провести мероприятие {date}")
        system.check_availability(self, date)

    def confirm_booking(self, system: "BookingSystem"):
        print(f"[Клиент] {self.name}: подтверждаю бронирование")
        system.start_payment(self)

    def send_feedback(self, system: "BookingSystem", text: str):
        print(f"[Клиент] {self.name}: отправляю отзыв: '{text}'")
        system.receive_feedback(self, text)


class PaymentGateway:
    def process_payment(self, amount: float) -> bool:
